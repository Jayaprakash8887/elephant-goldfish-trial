# Local environment values for cce-admin-service (section 9.3 of the design).
# Copy this file to .env (git-ignored) and replace every change-me with a local value.
# Never commit .env. This file holds placeholders only.
#
# DESIGN-GAP: Phase 1 says ".env.example holds every variable in section 9.3". Section 9.3 also
# lists the console's VITE_* values, but those belong to cce-admin-ui's own .env (AS-REQ-22), so
# only the two groups under the .env.example bullet of 9.3 are listed here.

# Secrets and the test administrator
POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
GATEWAY_STUB_CLIENT_SECRET=change-me
CCE_TEST_ADMIN_USERNAME=change-me
CCE_TEST_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_USERNAME=${CCE_TEST_ADMIN_USERNAME}

# Host-run values for the service
DATABASE_URL=jdbc:postgresql://localhost:5433/admin_service
DATABASE_USERNAME=admin_service
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
JWT_ISSUER=http://localhost:8180/auth/realms/cce
JWT_AUDIENCE=gateway-service
KEYCLOAK_SERVER_URL=http://localhost:8180/auth
KEYCLOAK_REALM=cce
GATEWAY_BASE_URL=http://localhost:8090
