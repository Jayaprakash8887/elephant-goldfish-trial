<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Used only for plugin and library versions; there is no Spring dependency at runtime. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.cce</groupId>
    <artifactId>cce-gateway-stub</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>cce-gateway-stub</name>
    <description>Local stand-in for gateway-service's sync endpoint (AD-11). Not the gateway.</description>

    <properties>
        <java.version>21</java.version>
        <start-class>org.cce.gatewaystub.GatewayStubMain</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- D-05 pins 42.7.14, an explicit override of the parent's managed version. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The parent's shade setup builds a runnable jar with ${start-class} as its main class.
                 DESIGN-GAP: that setup has createDependencyReducedPom=true, so every package writes
                 gateway-stub/dependency-reduced-pom.xml next to this file, which no .gitignore covers.
                 The phase allows no configuration here and no .gitignore change; the file is a build
                 output and must not be committed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
