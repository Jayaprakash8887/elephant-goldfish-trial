# Serves the console on port 3002 (UI-AD-16). Runtime variables:
#   GATEWAY_UPSTREAM  required; gateway-service, never the admin service directly (PRD §9).
#   KEYCLOAK_ORIGIN   optional; Keycloak's origin when it differs from the console's.

:3002 {
	encode zstd gzip

	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' {$KEYCLOAK_ORIGIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
	}

	handle /admin/v1/* {
		reverse_proxy {$GATEWAY_UPSTREAM}
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
