# Local values from admin-service §9.3. None is a secret.

# Keycloak base URL: the M0 Keycloak, reached directly (not through the Vite proxy).
VITE_KEYCLOAK_URL=http://localhost:8180/auth
# Keycloak realm; required, with no default (PRD §8.3).
VITE_KEYCLOAK_REALM=cce
# The console's public Keycloak client (PKCE S256, D-03).
VITE_KEYCLOAK_CLIENT_ID=cce-admin-ui
# Admin API base URL; empty, so requests go to /admin/v1 and the Vite proxy forwards them.
VITE_API_BASE_URL=

# The browser tests read CCE_TEST_ADMIN_USERNAME and CCE_TEST_ADMIN_PASSWORD from the
# environment only. Do not add them to this file.
